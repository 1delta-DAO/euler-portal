VERIFIER_URL_146=https://api.etherscan.io/v2/api?chainid=146            # Sonic
VERIFIER_URL_80094=https://api.etherscan.io/v2/api?chainid=80094        # Berachain
VERIFIER_URL_1329=https://api.etherscan.io/v2/api?chainid=1329          # Sei
