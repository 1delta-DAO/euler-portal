# ── Per-chain verifier URLs (Etherscan V2) ─────────────────────────
# Etherscan V2 uses a single endpoint with chainid parameter.
# Verifier defaults to "etherscan" if VERIFIER_{chainId} is not set.
# For non-Etherscan chains, set VERIFIER_{chainId}=blockscout and provide a Blockscout URL.

VERIFIER_URL_1=https://api.etherscan.io/v2/api?chainid=1               # Ethereum
VERIFIER_URL_42161=https://api.etherscan.io/v2/api?chainid=42161        # Arbitrum One
VERIFIER_URL_8453=https://api.etherscan.io/v2/api?chainid=8453         # Arbitrum One
VERIFIER_URL_143=https://api.etherscan.io/v2/api?chainid=143           # Monad
